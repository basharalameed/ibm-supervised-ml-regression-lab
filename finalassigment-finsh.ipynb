    "# =============================================================================\n",
    "# SECTION 3: TRAIN, CROSS-VALIDATE & COMPARE 6 LINEAR REGRESSION VARIATIONS\n",
    "# =============================================================================\n",
    "from sklearn.linear_model import LinearRegression, RidgeCV, LassoCV, ElasticNetCV\n",
    "from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error\n",
    "from sklearn.model_selection import cross_val_score\n",
    "\n",
    "bmi_idx = feature_names.index('BMI')\n",
    "alphas_grid = np.logspace(-2, 3, 100)\n",
    "\n",
    "# Fit the 6 Linear Regression variations\n",
    "m1_simple = LinearRegression().fit(X_train_scaled[:, [bmi_idx]], y_train)\n",
    "m2_ols = LinearRegression().fit(X_train_scaled, y_train)\n",
    "m3_ridge = RidgeCV(alphas=alphas_grid, cv=5).fit(X_train_scaled, y_train)\n",
    "m4_lasso = LassoCV(alphas=alphas_grid, cv=5, random_state=42).fit(X_train_scaled, y_train)\n",
    "m5_elastic = ElasticNetCV(l1_ratio=[0.1, 0.3, 0.5, 0.7, 0.9], alphas=alphas_grid, cv=5, random_state=42).fit(X_train_scaled, y_train)\n",
    "m6_poly_ridge = RidgeCV(alphas=np.logspace(1, 4, 50), cv=5).fit(X_train_poly, y_train)\n",
    "\n",
    "model_entries = [\n",
    "    (\"1. Simple Linear Regression (BMI Only)\", m1_simple, X_train_scaled[:, [bmi_idx]], X_test_scaled[:, [bmi_idx]]),\n",
    "    (\"2. Multiple OLS Linear Regression (All 10)\", m2_ols, X_train_scaled, X_test_scaled),\n",
    "    (f\"3. Ridge Regression (L2, alpha={m3_ridge.alpha_:.2f})\", m3_ridge, X_train_scaled, X_test_scaled),\n",
    "    (f\"4. Lasso Regression (L1, alpha={m4_lasso.alpha_:.2f})\", m4_lasso, X_train_scaled, X_test_scaled),\n",
    "    (f\"5. ElasticNet Regression (alpha={m5_elastic.alpha_:.2f}, l1={m5_elastic.l1_ratio_:.1f})\", m5_elastic, X_train_scaled, X_test_scaled),\n",
    "    (f\"6. Polynomial Degree-2 Ridge (alpha={m6_poly_ridge.alpha_:.2f})\", m6_poly_ridge, X_train_poly, X_test_poly),\n",
    "]\n",
    "\n",
    "n_test = len(y_test)\n",
    "comp_records = []\n",
    "for label, model, X_tr, X_te in model_entries:\n",
    "    pred_tr = model.predict(X_tr)\n",
    "    pred_te = model.predict(X_te)\n",
    "    tr_r2 = r2_score(y_train, pred_tr)\n",
    "    te_r2 = r2_score(y_test, pred_te)\n",
    "    cv_r2 = cross_val_score(LinearRegression(), X_tr, y_train, cv=5, scoring='r2').mean()\n",
    "    k_active = max(1, int(np.sum(np.abs(model.coef_) > 1e-4)))\n",
    "    adj_te_r2 = 1.0 - (1.0 - te_r2) * (n_test - 1) / max(1, (n_test - k_active - 1))\n",
    "    rmse = np.sqrt(mean_squared_error(y_test, pred_te))\n",
    "    mae = mean_absolute_error(y_test, pred_te)\n",
    "    comp_records.append({\n",
    "        'Model_Variation': label,\n",
    "        'Train_R2': round(tr_r2, 4),\n",
    "        'CV_5Fold_R2': round(cv_r2, 4),\n",
    "        'Test_R2': round(te_r2, 4),\n",
    "        'Adj_Test_R2': round(adj_te_r2, 4),\n",
    "        'Test_RMSE': round(rmse, 2),\n",
    "        'Test_MAE': round(mae, 2),\n",
    "        'Active_Features': k_active\n",
    "    })\n",
    "\n",
    "comp_df = pd.DataFrame(comp_records)\n",
    "print(\"=== SECTION 3: LINEAR REGRESSION MODEL VARIATIONS COMPARISON ===\")\n",
    "print(comp_df.to_string(index=False))\n",
    "\n",
    "# Plot Test R2 and RMSE across models\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4.5))\n",
    "axes[0].barh(comp_df['Model_Variation'], comp_df['Test_R2'], color='teal', edgecolor='black')\n",
    "axes[0].set_title(\"Test R² Across Linear Regression Variations (Higher is Better)\")\n",
    "axes[0].set_xlabel(\"Test R²\")\n",
    "axes[1].barh(comp_df['Model_Variation'], comp_df['Test_RMSE'], color='darkorange', edgecolor='black')\n",
    "axes[1].set_title(\"Test RMSE Across Linear Regression Variations (Lower is Better)\")\n",
    "axes[1].set_xlabel(\"Test RMSE\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
