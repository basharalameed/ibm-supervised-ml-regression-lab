    "# =============================================================================\n",
    "# SECTION 4: FINDINGS & INTERPRETATION — COEFFICIENTS & ACTUAL VS PREDICTED\n",
    "# =============================================================================\n",
    "coef_df = pd.DataFrame({\n",
    "    'Feature': feature_names,\n",
    "    'OLS_Coef': np.round(m2_ols.coef_, 2),\n",
    "    'Ridge_Coef': np.round(m3_ridge.coef_, 2),\n",
    "    'Lasso_Coef': np.round(m4_lasso.coef_, 2),\n",
    "    'ElasticNet_Coef': np.round(m5_elastic.coef_, 2)\n",
    "}).sort_values(by='Lasso_Coef', ascending=False)\n",
    "\n",
    "print(\"=== SECTION 4: STANDARDIZED REGRESSION COEFFICIENTS & INTERPRETATION ===\")\n",
    "print(coef_df.to_string(index=False))\n",
    "\n",
    "# Visualize Standardized Coefficients & Actual vs. Predicted Values\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "y_pos = np.arange(len(feature_names))\n",
