    "# =============================================================================\n",
    "# SECTION 1: LOAD ACTUAL DATASET, FEATURE DISTRIBUTIONS & TARGET RELATIONSHIPS\n",
    "# =============================================================================\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.datasets import load_diabetes\n",
    "\n",
    "# Load the actual Efron et al. (2004) Diabetes dataset from scikit-learn\n",
    "diabetes_bunch = load_diabetes(as_frame=True, scaled=False)\n",
    "df = diabetes_bunch.frame.copy()\n",
    "df.rename(columns={\n",
    "    'age': 'Age', 'sex': 'Sex', 'bmi': 'BMI', 'bp': 'Blood_Pressure',\n",
    "    's1': 'Total_Cholesterol', 's2': 'LDL_Cholesterol', 's3': 'HDL_Cholesterol',\n",
    "    's4': 'Total_HDL_Ratio', 's5': 'Log_Triglycerides', 's6': 'Blood_Sugar',\n",
    "    'target': 'Disease_Progression'\n",
    "}, inplace=True)\n",
    "\n",
    "print(\"=== SECTION 1: ACTUAL DATASET LOADING, DISTRIBUTIONS & CORRELATIONS ===\")\n",
    "print(f\"Dataset Shape         : {df.shape} -> {df.shape[0]} patients, 10 predictors, 1 target\")\n",
    "print(f\"Total Missing Values  : {df.isnull().sum().sum()}\")\n",
    "print(f\"Duplicate Rows        : {df.duplicated().sum()}\\n\")\n",
    "\n",
    "# Compute summary statistics, feature distributions (skewness/quartiles), and target correlations\n",
    "summary_stats = df.describe().T[['count', 'mean', 'std', 'min', '25%', '50%', '75%', 'max']]\n",
    "summary_stats['skew'] = df.skew()\n",
    "summary_stats['corr_with_target'] = df.corr()['Disease_Progression']\n",
    "print(\"--- Summary Statistics & Feature Distributions (Mean, SD, Skewness, Quartiles) ---\")\n",
    "print(summary_stats.round(3))\n",
    "\n",
    "# Plot Feature Distributions (Histograms) & Predictor-Target Relationships (Scatter + Trendlines)\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "key_vars = ['BMI', 'Log_Triglycerides', 'Blood_Pressure', 'HDL_Cholesterol', 'Blood_Sugar', 'Disease_Progression']\n",
    "for ax, col in zip(axes.flatten(), key_vars):\n",
    "    if col == 'Disease_Progression':\n",
    "        ax.hist(df[col], bins=25, color='steelblue', edgecolor='black', alpha=0.85)\n",
    "        ax.set_title(f\"Target Distribution: {col}\")\n",
    "        ax.set_xlabel(col)\n",
    "        ax.set_ylabel(\"Frequency\")\n",
    "    else:\n",
    "        ax.scatter(df[col], df['Disease_Progression'], alpha=0.5, color='teal', edgecolors='k', s=25)\n",
    "        m, b = np.polyfit(df[col], df['Disease_Progression'], 1)\n",
    "        ax.plot(df[col], m * df[col] + b, color='crimson', linewidth=2)\n",
    "        r_val = df[col].corr(df['Disease_Progression'])\n",
    "        ax.set_title(f\"{col} vs. Target (r = {r_val:+.3f})\")\n",
    "        ax.set_xlabel(col)\n",
    "        ax.set_ylabel(\"Disease_Progression\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
