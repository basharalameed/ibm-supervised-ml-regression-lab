    "# =============================================================================\n",
    "# SECTION 2: PREPROCESSING, TRAIN/TEST SPLIT & MULTICOLLINEARITY (VIF) CHECK\n",
    "# =============================================================================\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler, PolynomialFeatures\n",
    "\n",
    "feature_names = [\n",
    "    'Age', 'Sex', 'BMI', 'Blood_Pressure', 'Total_Cholesterol',\n",
    "    'LDL_Cholesterol', 'HDL_Cholesterol', 'Total_HDL_Ratio', 'Log_Triglycerides', 'Blood_Sugar'\n",
    "]\n",
    "X = df[feature_names].values\n",
    "y = df['Disease_Progression'].values\n",
    "\n",
    "# 80/20 Train-Test Split\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=42\n",
    ")\n",
    "\n",
    "# Standardize predictors using training set statistics\n",
    "scaler = StandardScaler()\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "# Engineer Degree-2 Polynomial & Interaction Features\n",
    "poly = PolynomialFeatures(degree=2, include_bias=False)\n",
    "X_train_poly = scaler.fit_transform(poly.fit_transform(X_train))\n",
    "X_test_poly = scaler.transform(poly.transform(X_test))\n",
    "\n",
    "# Compute Variance Inflation Factors (VIF) from inverse correlation matrix\n",
    "corr_matrix = np.corrcoef(X_train_scaled, rowvar=False)\n",
    "vif_vals = np.diag(np.linalg.inv(corr_matrix))\n",
    "vif_df = pd.DataFrame({\n",
    "    'Feature': feature_names,\n",
    "    'VIF': np.round(vif_vals, 2),\n",
    "    'Collinearity_Status': [\n",
    "        'Severe Multicollinearity (VIF>10)' if v > 10 else ('Moderate Collinearity (VIF>5)' if v > 5 else 'Low (Acceptable)')\n",
    "        for v in vif_vals\n",
    "    ]\n",
    "}).sort_values(by='VIF', ascending=False)\n",
    "\n",
    "print(\"=== SECTION 2: DATA PREPROCESSING, SPLIT & MULTICOLLINEARITY (VIF) AUDIT ===\")\n",
    "print(f\"Training Set Shape : {X_train_scaled.shape} | Test Set Shape : {X_test_scaled.shape}\")\n",
    "print(f\"Degree-2 Polynomial Features Shape : {X_train_poly.shape}\\n\")\n",
    "print(\"--- Variance Inflation Factor (VIF) Audit on Predictors ---\")\n",
    "print(vif_df.to_string(index=False))"
   ]
